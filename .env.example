# VITE_API_BASE_URL: The URL of the Python backend (e.g., http://localhost:5000)
# Used by Vite's dev server to proxy /api requests to the backend.
VITE_API_BASE_URL="http://localhost:5050"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# ─── Timezone ──────────────────────────────────────────
TZ=Asia/Kolkata

# ─── Database ──────────────────────────────────────────
# For Docker: MYSQL_USER/MYSQL_PASSWORD are auto-created by the official
#   MySQL image on first container start — the defaults below work as-is.
# For a local (non-Docker) MySQL install: that user does NOT exist
#   automatically. Either:
#   (a) change MYSQL_USER/MYSQL_PASSWORD below to your existing local
#       MySQL account (e.g. root + its password) — simplest option, or
#   (b) create the rkmvc_app user yourself first:
#         CREATE USER 'rkmvc_app'@'localhost' IDENTIFIED BY 'rkmvc_app_password';
#         CREATE DATABASE IF NOT EXISTS rkmvc_mealflow_db;
#         GRANT ALL PRIVILEGES ON rkmvc_mealflow_db.* TO 'rkmvc_app'@'localhost';
#         FLUSH PRIVILEGES;
MYSQL_ROOT_PASSWORD=AkashPillai@123
MYSQL_DATABASE=rkmvc_mealflow_db
MYSQL_USER=meal_app
MYSQL_PASSWORD=Admin@RKMVC2
# ─── Flask Backend Secrets ─────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string
QR_HMAC_SECRET=change-this-to-another-random-64-char-string
TOKEN_EXPIRY_DEFAULT=60

# ─── URLs ──────────────────────────────────────────────
STUDENT_LOGIN_URL=http://localhost/student/
# Only needed if you also run the registration-backend service separately
REGISTRATION_BACKEND_URL=http://localhost:5001

# ─── SMTP Email (optional — leave blank to disable email) ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@rkmvc.ac.in
